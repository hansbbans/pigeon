{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run check)",
      "Bash(npx tsc:*)",
      "Bash(xcodegen generate)",
      "Bash(xcodegen generate:*)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild test:*)",
      "Bash(npx wrangler deployments list)",
      "Bash(npx wrangler deployments list:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.env*)",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.*)",
      "Read(./**/.env*)",
      "Bash(gh run cancel:*)"
    ]
  }
}
