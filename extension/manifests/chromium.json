{
  "manifest_version": 3,
  "name": "Save to Pigeon",
  "description": "Save pages and links to Pigeon's Read It Later.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Pigeon",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current page to Pigeon"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://pigeon.hanscho.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
