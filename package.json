{
  "name": "pigeon",
  "version": "1.0.0",
  "private": true,
  "description": "Newsletter-to-RSS converter on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-workers.mjs",
    "dev:main": "wrangler dev --config wrangler.toml --local --port 8787 --inspector-port 9231",
    "dev:recommendations": "wrangler dev --config wrangler.recommendations.toml --local --port 8788 --inspector-port 9230",
    "deploy": "npm run deploy:recommendations && npm run deploy:main",
    "deploy:recommendations": "wrangler deploy --config wrangler.recommendations.toml",
    "deploy:main": "wrangler deploy --config wrangler.toml",
    "tail": "wrangler tail",
	"test": "tsx --test test/*.test.ts",
	"test:testflight": "node --test test/app-store-connect-verify.test.mjs",
	"typecheck": "tsc --noEmit",
	"audit": "npm audit --audit-level=high",
	"check": "npm test && npm run typecheck && npm run audit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "postal-mime": "^2.7.3"
  }
}
